<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="알고리즘 판정"
        android:textColor="#666666"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/txtPrediction"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="스캔 중..."
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/txtRunnerUp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:fontFamily="monospace"
        android:textColor="#666666"
        android:textSize="13sp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginVertical="24dp"
        android:background="#DDDDDD" />

    <Button
        android:id="@+id/btnCorrect"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:text="맞음"
        android:textSize="17sp" />

    <Button
        android:id="@+id/btnWrong"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_marginTop="10dp"
        android:text="다름 — 실제 배송지 선택"
        android:textSize="17sp" />

    <Button
        android:id="@+id/btnNotDoor"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="10dp"
        android:text="배송지 아님 (복도·이동 중)"
        android:textSize="15sp" />

    <Button
        android:id="@+id/btnUndo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="방금 기록 취소" />

    <TextView
        android:id="@+id/txtStatus"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:layout_weight="1"
        android:textColor="#666666"
        android:textSize="12sp" />
</LinearLayout>
